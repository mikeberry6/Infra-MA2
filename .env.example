# Database
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Required by explicit database mutation commands such as admin:create.
EXPECTED_DATABASE_HOST=
EXPECTED_DATABASE_NAME=
FORBIDDEN_DATABASE_HOST=
FORBIDDEN_DATABASE_HOST_2=

# Auth
# Include the retained base path, for example:
# https://example.com/Infra-MA2/api/auth
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Supplied only when running `npm run admin:create`; ordinary seeding ignores
# these values and never creates an administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Vercel / Neon integration variables may also be present locally after
# `vercel env pull`, but they should not be committed with values.
DATABASE_NEON_PROJECT_ID=
DATABASE_PGHOST=
DATABASE_PGHOST_UNPOOLED=
DATABASE_PGDATABASE=
DATABASE_PGUSER=
DATABASE_PGPASSWORD=

# Dashboard data providers
# Treasury, Federal Register, and USAspending run without keys.
FRED_API_KEY=
EIA_API_KEY=
SAM_API_KEY=
SEC_USER_AGENT=
SEC_WATCHLIST_CIKS=
DASHBOARD_WRITES_ENABLED=false
